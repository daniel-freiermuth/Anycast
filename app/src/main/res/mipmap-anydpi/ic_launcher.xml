<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 34, so this adaptive icon is the only launcher icon that ships -
  there are no legacy density-bucket PNG fallbacks.

  The foreground is pure white on transparent, so it is reused verbatim as the
  themed <monochrome> layer; the system supplies that layer's tint.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
  <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
