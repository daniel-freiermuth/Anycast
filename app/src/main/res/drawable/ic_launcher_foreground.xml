<?xml version="1.0" encoding="utf-8"?>
<!--
  CreoleCast launcher foreground: a three-bar audio level meter broadcasting
  through two pairs of signal arcs - audio streaming out to a cast target.

  All geometry is stroked with round caps so the mark keeps its weight when the
  launcher downscales it. Everything stays inside the 66dp adaptive-icon safe
  zone (radius 33 around the 54,54 centre): the outer arc sits at radius 30 plus
  half of its 6dp stroke.

  Pure white on transparent, so this drawable doubles as the <monochrome> layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Level meter: short / tall / short -->
    <path
        android:pathData="M46,46.25 V61.75 M54,38.25 V69.75 M62,46.25 V61.75"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Inner signal arcs -->
    <path
        android:pathData="M70.72,38.94 A22.5,22.5 0 0 1 70.72,69.06 M37.28,38.94 A22.5,22.5 0 0 0 37.28,69.06"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Outer signal arcs -->
    <path
        android:pathData="M76.29,33.92 A30,30 0 0 1 76.29,74.08 M31.71,33.92 A30,30 0 0 0 31.71,74.08"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
